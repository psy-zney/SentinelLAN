POSTGRES_DB=sentinellan
POSTGRES_USER=sentinellan
POSTGRES_PASSWORD=change-me-for-local-development
ConnectionStrings__SentinelLAN=Host=localhost;Port=5432;Database=sentinellan;Username=sentinellan;Password=change-me-for-local-development
SENTINELLAN_DEMO_ADMIN_EMAIL=admin@sentinellan.local
SENTINELLAN_DEMO_ADMIN_PASSWORD=local-demo-only
SENTINELLAN_ENROLLMENT_TOKEN=create-with-seed-demo
# Generate three different random secrets (at least 32 characters each) before starting Compose.
# Keep this file as a template; never commit the populated .env file.
SENTINELLAN_SIGNING_KEY=
SENTINELLAN_ACCESS_TOKEN_SIGNING_KEY=
SENTINELLAN_SERVER_VAULT_KEY=
SENTINELLAN_WEB_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
SENTINELLAN_API_URL=http://localhost:8080
# Optional local VPS monitor. Only Admins in this organization can read the snapshot.
SENTINELLAN_HOST_MONITOR_ORG_CODE=
SENTINELLAN_HOST_SNAPSHOT_PATH=
# API URL reachable by employee devices; embedded in the company-specific installer.
# Use trusted HTTPS for company LAN devices. Loopback HTTP is for local development only.
SENTINELLAN_AGENT_PUBLIC_URL=http://localhost:8080

# Optional product upgrade features; see docs/guides/product-upgrade.md
SENTINELLAN_AGENT_REQUIRE_SIGNED_REQUESTS=
SENTINELLAN_AGENT_LEGACY_AUTH_UNTIL=
SENTINELLAN_REDIS_CONNECTION=
SENTINELLAN_REDIS_CHANNEL_PREFIX=
SENTINELLAN_ATTACHMENT_STORAGE=Database
SENTINELLAN_ATTACHMENT_USER_DAILY_BYTES=20971520
SENTINELLAN_ATTACHMENT_ORGANIZATION_DAILY_BYTES=209715200
SENTINELLAN_ATTACHMENT_ORGANIZATION_TOTAL_BYTES=2147483648
SENTINELLAN_INGRESS_REQUESTS_PER_MINUTE=600
SENTINELLAN_INGRESS_BURST=300
SENTINELLAN_INGRESS_CONCURRENCY=128
# Production rejects SHA256 password hashes unless a temporary UTC deadline (at most 7 days) is set.
SENTINELLAN_LEGACY_PASSWORD_HASHES_UNTIL=
SENTINELLAN_S3_ENDPOINT=
SENTINELLAN_S3_REGION=
SENTINELLAN_S3_BUCKET=
SENTINELLAN_S3_ACCESS_KEY=
SENTINELLAN_S3_SECRET_KEY=
SENTINELLAN_S3_FORCE_PATH_STYLE=false
SENTINELLAN_BOOTSTRAP_WINDOWS_URL=
SENTINELLAN_BOOTSTRAP_WINDOWS_SHA256=
SENTINELLAN_BOOTSTRAP_WINDOWS_PUBLISHER=
SENTINELLAN_BOOTSTRAP_LINUX_URL=
SENTINELLAN_BOOTSTRAP_LINUX_SHA256=
