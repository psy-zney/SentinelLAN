{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.17.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://manager.zney295.id.vn",
        "EXPO_PUBLIC_WEB_URL": "https://manager.zney295.id.vn"
      }
    },
    "preview": {
      "node": "24.17.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://manager.zney295.id.vn",
        "EXPO_PUBLIC_WEB_URL": "https://manager.zney295.id.vn"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.17.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://manager.zney295.id.vn",
        "EXPO_PUBLIC_WEB_URL": "https://manager.zney295.id.vn"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
