<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>SentinelLAN-Agent-Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CompanyServerUrl" Value="$(CompanyServerUrl)" />
    <AssemblyMetadata Include="CommandPublicKey" Value="$(CommandPublicKey)" />
    <AssemblyMetadata Include="CommandKeyId" Value="$(CommandKeyId)" />
    <ProjectReference Include="..\SentinelLAN.Agent.Core\SentinelLAN.Agent.Core.csproj" />
    <ProjectReference Include="..\SentinelLAN.Agent.Infrastructure\SentinelLAN.Agent.Infrastructure.csproj" />
    <Content Include="..\..\..\..\deploy\agent\maintenance-popup.ps1" Link="maintenance-popup.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
