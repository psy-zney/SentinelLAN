{
  "name": "sentinellan",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.17.0 <25", "npm": ">=11.13.0 <12" },
  "workspaces": ["apps/web", "apps/mobile", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@sentinellan/web",
    "dev:mobile": "npm run dev --workspace=@sentinellan/mobile",
    "lint": "npm run lint --workspace=@sentinellan/web",
    "lint:mobile": "npm run lint --workspace=@sentinellan/mobile",
    "typecheck": "npm run typecheck --workspace=@sentinellan/web",
    "typecheck:mobile": "npm run typecheck --workspace=@sentinellan/mobile",
    "test": "npm run test --workspace=@sentinellan/web",
    "test:mobile": "npm run test --workspace=@sentinellan/mobile",
    "test:e2e": "npm run test:e2e --workspace=@sentinellan/web",
    "build": "npm run build --workspace=@sentinellan/web"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  }
}
