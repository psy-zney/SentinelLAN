[Unit]
Description=SentinelLAN Endpoint Management & Governance Agent
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinellan
Group=sentinellan
WorkingDirectory=/opt/sentinellan-agent
ExecStart=/opt/sentinellan-agent/sentinellan-agent
Restart=always
RestartSec=10
EnvironmentFile=/etc/sentinellan/agent.env
StateDirectory=sentinellan-agent
LimitNOFILE=65535

# Security hardening
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/sentinellan-agent
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
