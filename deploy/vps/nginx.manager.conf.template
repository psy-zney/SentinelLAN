# Install as a NEW site, leaving default and existing project sites unchanged.
# Uses a Let's Encrypt certificate for manager.zney295.id.vn and Cloudflare Full (strict).
# Provision the verified CIDRs from https://api.cloudflare.com/client/v4/ips in the allow snippet.
# Replace TLS_DIRECTORY with the actual internal CA directory before nginx -t.
# Load nginx.auth-limit.conf in the host http context once.
server {
    listen 80;
    listen [::]:80;
    server_name manager.zney295.id.vn;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sentinellan-manager-acme;
        default_type text/plain;
    }
    location / { return 308 https://manager.zney295.id.vn$request_uri; }
}
server {
    listen 443 ssl;
    include /etc/nginx/snippets/sentinellan-cloudflare-allow.conf;
    listen [::]:443 ssl;
    server_name manager.zney295.id.vn;
    ssl_certificate /etc/letsencrypt/live/manager.zney295.id.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/manager.zney295.id.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log off;
    client_max_body_size 16M;
    # The allow snippet admits verified Cloudflare networks and loopback probes only.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
    add_header Cache-Control $sentinellan_cache_control always;
    proxy_ssl_protocols TLSv1.3;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_name gateway;
    proxy_ssl_server_name on;
    proxy_ssl_trusted_certificate TLS_DIRECTORY/gateway/ca.crt;
    proxy_http_version 1.1;
    proxy_set_header Host manager.zney295.id.vn;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sentinellan-manager-acme;
        default_type text/plain;
    }
    location ~ ^/api/v1/(?:mobile/)?auth/(?:login|refresh|activate)$ {
        limit_req zone=sentinellan_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass https://127.0.0.1:9003;
        proxy_hide_header Cache-Control;
    }
    location /api/ {
        proxy_pass https://127.0.0.1:9003;
        proxy_hide_header Cache-Control;
    }
    location /hubs/ {
        proxy_pass https://127.0.0.1:9003;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
    location /downloads/windows-x64/ {
        alias /opt/sentinellan/shared/downloads/windows-x64/;
        autoindex off;
        default_type application/octet-stream;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300" always;
        limit_except GET HEAD { deny all; }
    }
    location / { proxy_pass https://127.0.0.1:9003; }
}
