# SentinelLAN Production Environment Configuration
# Copy this file to .env before deploying on your VPS

# PostgreSQL Database
POSTGRES_DB=sentinellan
POSTGRES_USER=sentinellan
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# Public HTTPS hostname
PUBLIC_DOMAIN=sentinel.example.com

# Initial Organization Administrator (only used for an empty database)
BOOTSTRAP_ORG_CODE=sentinellan
BOOTSTRAP_ORG_NAME=SentinelLAN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=generate_a_strong_admin_password_here

# Cryptographic Keys (Must be minimum 32 characters, preferably 64 hex characters)
COMMAND_PRIVATE_KEY_PEM=
COMMAND_KEY_ID=company-2026-01
ACCESS_TOKEN_SIGNING_KEY=generate_64_char_hex_jwt_signing_key_here
SERVER_VAULT_KEY=generate_a_different_64_char_hex_vault_key_here
SENTINELLAN_DATA_ENCRYPTION_KEY=

# When using docker-compose.host-proxy.yaml behind the host's HTTPS Nginx
HOST_PROXY_PORT=9003
