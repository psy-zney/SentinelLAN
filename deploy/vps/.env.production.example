# SentinelLAN Production Environment Configuration
# Copy this file to .env before deploying on your VPS

# PostgreSQL Database
POSTGRES_DB=sentinellan
POSTGRES_USER=sentinellan
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# Public HTTPS hostname
PUBLIC_DOMAIN=sentinel.example.com

# Single company hosted by this server. IT configures the code; users sign in with email/password.
# BOOTSTRAP_ORG_CODE also pins login unless SENTINELLAN_LOGIN_ORG_CODE is explicitly set.
# Initial administrator email/password are used only for an empty database.
BOOTSTRAP_ORG_CODE=sentinellan
BOOTSTRAP_ORG_NAME=SentinelLAN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=generate_a_strong_admin_password_here

# Cryptographic Keys (Must be minimum 32 characters, preferably 64 hex characters)
COMMAND_PRIVATE_KEY_PEM=
COMMAND_KEY_ID=company-2026-01
ACCESS_TOKEN_SIGNING_KEY=generate_64_char_hex_jwt_signing_key_here
SERVER_VAULT_KEY=generate_a_different_64_char_hex_vault_key_here
SENTINELLAN_DATA_ENCRYPTION_KEY=

# When using docker-compose.host-proxy.yaml behind the host's HTTPS Nginx
HOST_PROXY_PORT=9003

# Fixed Nginx peer; choose a free subnet and an address within it for this stack.
SENTINELLAN_PROXY_SUBNET=172.30.10.0/24
SENTINELLAN_PROXY_IP=172.30.10.10
# Optional override; Compose otherwise trusts SENTINELLAN_PROXY_IP only.
SENTINELLAN_KNOWN_PROXIES=
SENTINELLAN_KNOWN_NETWORKS=

# Optional product upgrade features; see docs/guides/product-upgrade.md

SENTINELLAN_AGENT_REQUIRE_SIGNED_REQUESTS=
SENTINELLAN_AGENT_LEGACY_AUTH_UNTIL=
SENTINELLAN_REDIS_CONNECTION=
SENTINELLAN_REDIS_CHANNEL_PREFIX=
SENTINELLAN_ATTACHMENT_STORAGE=Database
SENTINELLAN_ATTACHMENT_USER_DAILY_BYTES=20971520
SENTINELLAN_ATTACHMENT_ORGANIZATION_DAILY_BYTES=209715200
SENTINELLAN_ATTACHMENT_ORGANIZATION_TOTAL_BYTES=2147483648
SENTINELLAN_INGRESS_REQUESTS_PER_MINUTE=600
SENTINELLAN_INGRESS_BURST=300
SENTINELLAN_INGRESS_CONCURRENCY=128
# Optional UTC deadline, no more than 7 days ahead; leave empty to reject legacy SHA256 passwords.
SENTINELLAN_LEGACY_PASSWORD_HASHES_UNTIL=
SENTINELLAN_S3_ENDPOINT=
SENTINELLAN_S3_REGION=
SENTINELLAN_S3_BUCKET=
SENTINELLAN_S3_ACCESS_KEY=
SENTINELLAN_S3_SECRET_KEY=
SENTINELLAN_S3_FORCE_PATH_STYLE=false
SENTINELLAN_BOOTSTRAP_WINDOWS_URL=
SENTINELLAN_BOOTSTRAP_WINDOWS_SHA256=
SENTINELLAN_BOOTSTRAP_WINDOWS_PUBLISHER=
SENTINELLAN_BOOTSTRAP_LINUX_URL=
SENTINELLAN_BOOTSTRAP_LINUX_SHA256=
