# Replace sentinel.example.com, TLS_DIRECTORY, and 9003 before installation.
# Install the limit_req_zone snippet in the host http context first.
server {
    listen 80;
    listen [::]:80;
    server_name sentinel.example.com;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sentinellan-acme;
        default_type text/plain;
    }
    location / { return 308 https://sentinel.example.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sentinel.example.com;
    ssl_certificate /etc/letsencrypt/live/sentinel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentinel.example.com/privkey.pem;
    ssl_protocols TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log off;
    client_max_body_size 16M;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
    add_header Cache-Control $sentinellan_cache_control always;
    proxy_ssl_protocols TLSv1.3;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_name gateway;
    proxy_ssl_server_name on;
    proxy_ssl_trusted_certificate TLS_DIRECTORY/gateway/ca.crt;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    location ~ ^/api/v1/(?:mobile/)?auth/(?:login|refresh|activate)$ {
        limit_req zone=sentinellan_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass https://127.0.0.1:9003;
        proxy_hide_header Cache-Control;
    }
    location /api/ {
        proxy_pass https://127.0.0.1:9003;
        proxy_hide_header Cache-Control;
    }
    location / { proxy_pass https://127.0.0.1:9003; }
}
