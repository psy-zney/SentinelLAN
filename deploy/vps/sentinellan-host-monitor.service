[Unit]
Description=SentinelLAN read-only VPS status collector
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/opt/sentinellan/shared/host-monitor.conf
ExecStart=/usr/bin/python3 -B /opt/sentinellan/current/deploy/vps/collect-host-status.py
TimeoutStartSec=90
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=-/home/ubuntu/exxplore-kittens -/home/ubuntu/livekit -/home/ubuntu/beatsync -/home/ubuntu/go
ReadWritePaths=/opt/sentinellan/shared/host-monitor
RestrictAddressFamilies=AF_UNIX AF_NETLINK
